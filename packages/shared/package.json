{
  "name": "@trade-robot/shared",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "fmt": "prettier -w .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.0",
    "eslint": "^10.0.1",
    "@eslint/js": "^9.32.0",
    "typescript-eslint": "^8.44.0",
    "prettier": "^3.6.0"
  }
}
